# Settings read by the code. Copy to .env and fill in; .env is git-ignored.
# In Azure, the function app's settings (Key Vault references for secrets)
# take the place of this file. Do not set FUNCTIONS_WORKER_RUNTIME here:
# Azure Functions sets it, and the scripts skip .env when it is present.

# Local database: SQL Server in Docker. build_db.py only ever builds this one.
# 1433 is SQL Server's standard port. Any name but a system database's.
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_DB=RedTree
MSSQL_USER=your-local-user
MSSQL_PASSWORD=change-me

# Azure SQL Database: the system of record, used by scripts given "azure".
AZURE_MSSQL_HOST=your-server.database.windows.net
AZURE_MSSQL_PORT=1433
AZURE_MSSQL_DB=redtree
AZURE_MSSQL_USER=your-admin-user
AZURE_MSSQL_PASSWORD=change-me

# Blob storage: one account, one container per kind of file.
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=youraccount;AccountKey=your-account-key;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=your-receipts-container
AZURE_EXTRACTION_CONTAINER=your-extractions-container
AZURE_ICAL_CONTAINER=your-calendar-container
AZURE_CATEGORISATION_CONTAINER=your-categorisations-container
AZURE_EXPORTS_CONTAINER=your-airbnb-exports-container

# Azure Document Intelligence: reads receipts and invoices.
AZURE_DOCINTEL_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_DOCINTEL_KEY=your-docintel-key

# Anthropic: categorises receipts (read by the anthropic SDK itself).
ANTHROPIC_API_KEY=your-anthropic-api-key

# Gmail: the receipts mailbox, read over IMAP, and used to send alerts.
GMAIL_USER=receipts-mailbox@example.com
GMAIL_APP_PASSWORD=your-app-password

# Alerts: where pipeline failures are sent.
ALERT_EMAIL=you@example.com

# Calendar feeds: one per listing, named by that listing's ical_url_setting
# in the property config (this is the example config's listing).
AIRBNB_ICAL_URL_SUITE=https://www.airbnb.com/calendar/ical/your-listing-id.ics?s=your-secret
