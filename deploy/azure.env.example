# Names used by the deploy scripts (azure_setup.sh, publish.sh, run_now.sh,
# set_secret.sh). Copy to deploy/azure.env (git-ignored) and fill in.
# No secrets here: those live in .env and, in Azure, in Key Vault.
# zsh syntax: the scripts read this file with `source`.

# Azure region for every resource, e.g. eastus (az account list-locations -o table).
LOCATION="your-azure-region"

# The resource group that holds everything.
RG="your-resource-group"

# Added to the names that must be unique across all of Azure. If one is
# taken, change SUFFIX and start azure_setup.sh again from section 1.
SUFFIX="yoursuffix"

# The data storage account: 3-24 lowercase letters and digits.
STORAGE="yourdata${SUFFIX}"

# The SQL server, its database and admin login (the password is typed in
# azure_setup.sh and kept in .env and Key Vault, never here).
SQL_SERVER="your-sql-${SUFFIX}"
SQL_DB="your-database"
SQL_ADMIN="your-sql-admin"

# Document Intelligence (receipt reading); also its custom domain.
DOCINTEL="your-docintel-${SUFFIX}"

# The blob containers: the same five names as the AZURE_*_CONTAINER settings
# in .env (receipts, extractions, calendar, categorisations, exports).
CONTAINERS=(your-receipts-container your-extractions-container your-calendar-container
            your-categorisations-container your-airbnb-exports-container)

# The function app, and its own housekeeping storage account (3-24 lowercase
# letters and digits).
FUNC_STORAGE="yourfunc${SUFFIX}"
FUNC_APP="your-pipeline-${SUFFIX}"

# The Key Vault holding the app's secrets: 3-24 letters, digits and hyphens.
KEYVAULT="kv-your-${SUFFIX}"

# The tenant ID these resources belong to: azure_setup.sh refuses to run
# signed in to any other (az account show --query tenantId -o tsv).
EXPECTED_TENANT="00000000-0000-0000-0000-000000000000"

# One Key Vault secret per listing calendar URL, as secret-name:SETTING_NAME.
# SETTING_NAME is that listing's ical_url_setting in the property config, and
# its value (the URL) is read from .env. Secret names use hyphens only.
ICAL_SECRETS=(ical-url-suite:AIRBNB_ICAL_URL_SUITE)
